# Copiar a .env solo para desarrollo local; .env está ignorado por git.
# En Cloud Run estas variables las inyecta Secret Manager. Aquí nunca van valores reales.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Una cadena por componente, cada uno con su propio usuario de base (tarea 2.3)
DATABASE_URL=

# Motor de decisión (sidecar en localhost). Si no responde a tiempo, se frena (K-3)
OPA_URL=http://localhost:8181
OPA_TIMEOUT_SEGUNDOS=2

# Servicio de emisión (solo lo invoca la cuenta de servicio de la app)
EMISION_URL=

# Solo en el servicio de emisión
FIRMA_CLAVE_PRIVADA=
